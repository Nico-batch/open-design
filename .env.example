# ── Qué sistema hay al otro lado ─────────────────────────────────────────────
#
# Este editor sirve a dos: Twenty CRM y `faro-redaccion`, la app editorial que lo va a
# sustituir. Es el MISMO repositorio desplegado dos veces, con esta variable cambiada.
# Ausente = `twenty`, que es lo que llevaba corriendo desde el principio.
#
#   twenty → GraphQL contra el CRM; el arte se queda en este disco y se enlaza
#   faro   → HTTP contra la app; el arte viaja a la app, que lo sirve firmado
#
# Cada valor usa un bloque de abajo y deja el otro sin definir.
FUENTE=twenty

# ── FUENTE=twenty ────────────────────────────────────────────────────────────

# Instancia y token de API (Settings → API & Webhooks). El token da acceso a todo el
# workspace; no hay alcance más granular en Twenty, así que trátalo como un secreto de
# servidor (nunca en el navegador).
TWENTY_API_URL=https://crm.tu-dominio.com
TWENTY_TOKEN=

# URL pública por la que Twenty (y quien consuma "Imagen Editada") puede hacer GET a las
# imágenes exportadas. En local casi nunca es alcanzable desde fuera — para probar el
# flujo completo hace falta el dominio real de despliegue o un túnel temporal.
# Solo la necesita `FUENTE=twenty`: con `faro` el arte no se queda aquí.
PUBLIC_BASE_URL=http://localhost:8787

# ── FUENTE=faro ──────────────────────────────────────────────────────────────

# Base de la app editorial. Puede ser el dominio público o, si comparten red de Docker,
# el nombre interno del servicio: la firma del arte cubre la ruta y la caducidad, no el
# host, así que reapuntarlo no invalida nada.
FARO_API_URL=https://redaccion.tu-dominio.com
# El mismo valor que la app tiene en su `FARO_API_KEY`. Va en la cabecera `X-Faro-Key`.
FARO_API_KEY=

# ── Siempre ──────────────────────────────────────────────────────────────────

# Basic Auth propia de la app — protege TODA la web. Con `FUENTE=twenty` deja fuera el GET
# de /api/uploads (necesario para que Twenty y Meta puedan descargar el arte sin
# credenciales); con `FUENTE=faro` no hay excepción ninguna. Obligatorias: el servidor no
# arranca sin ambas. Cámbialas por unas tuyas; no reutilices ningún ejemplo.
EDITOR_USER=
EDITOR_PASSWORD=
